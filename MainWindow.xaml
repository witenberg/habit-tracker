<Window x:Class="HabitTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabitTracker"
        xmlns:models="clr-namespace:HabitTracker.Models"
        xmlns:viewModels="clr-namespace:HabitTracker.ViewModels"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Habit Tracker - Dashboard"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F9F9F9"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryGreen"
                Color="#2ECC71"/>
        <SolidColorBrush x:Key="DarkGreen"
                Color="#27AE60"/>
        <SolidColorBrush x:Key="TextDark"
                Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextGray"
                Color="#7F8C8D"/>
        <SolidColorBrush x:Key="CardBackground"
                Color="White"/>

        <Style x:Key="PrimaryButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="15,8"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource DarkGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="SecondaryButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextDark}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="BorderBrush"
                    Value="#BDC3C7"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#ECF0F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Przycisk wylogowania -->
        <Style x:Key="LogoutButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#E74C3C"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#FFEBEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Przycisk usuwania -->
        <Style x:Key="DeleteHabitButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#E74C3C"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Padding"
                    Value="5"/>
            <Setter Property="VerticalAlignment"
                    Value="Top"/>
            <Setter Property="ToolTip"
                    Value="Usuń nawyk"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <TextBlock Text="✕"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#FFEBEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Nawyk -->
        <Style x:Key="HabitCardStyle"
                TargetType="Border">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Margin"
                    Value="5,5,5,10"/>
            <Setter Property="Padding"
                    Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black"
                            Direction="270"
                            ShadowDepth="2"
                            BlurRadius="10"
                            Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

       <DataTemplate x:Key="BooleanHabitTemplate" DataType="{x:Type models:BooleanHabit}">
            <Border Style="{StaticResource HabitCardStyle}" 
                    x:Name="BooleanBorder" Loaded="BooleanHabitBorder_Loaded" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="Auto"/> </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" 
                                   Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                        
                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TextGray}" 
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,5"
                                   />

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="🔥 Seria:" FontWeight="SemiBold" Foreground="#F39C12" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CurrentStreak, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="dni" Margin="3,0,0,0" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BooleanButton" Grid.Column="1" Content="✓ Zrobione" 
                            Width="120" Height="40" 
                            Click="BooleanHabitButton_Click"
                            Tag="{Binding}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center"
                            Loaded="BooleanHabitButton_Loaded"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="2" 
                            Style="{StaticResource DeleteHabitButtonStyle}"
                            Tag="{Binding}"
                            Click="DeleteHabitButton_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="QuantitativeHabitTemplate" DataType="{x:Type models:QuantitativeHabit}">
            <Border Style="{StaticResource HabitCardStyle}" 
                    x:Name="QuantitativeBorder" Loaded="QuantitativeHabitBorder_Loaded" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/> </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" 
                                   Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                        
                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TextGray}" 
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,5"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="🎯 Cel:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryGreen}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding TargetValue}" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="{Binding Unit}" Margin="3,0,0,0" Foreground="{StaticResource TextDark}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border BorderBrush="{StaticResource TextGray}" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0" Height="40" Background="#F9F9F9">
                            <TextBox x:Name="ValueTextBox" Width="70" 
                                     Tag="{Binding}"
                                     VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                     BorderThickness="0" Background="Transparent" FontWeight="SemiBold"
                                     Loaded="ValueTextBox_Loaded"/>
                        </Border>
                        
                        <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="0,0,10,0" 
                                   Foreground="{StaticResource TextGray}" FontWeight="SemiBold"/>

                        <Button x:Name="QuantitativeButton" Content="Zapisz" Width="80" Height="40"
                                Click="QuantitativeHabitButton_Click"
                                Tag="{Binding ElementName=ValueTextBox}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="#3498DB" 
                                Loaded="QuantitativeHabitButton_Loaded"/> 
                    </StackPanel>

                    <Button Grid.Column="2" 
                            Style="{StaticResource DeleteHabitButtonStyle}"
                            Tag="{Binding}"
                            Click="DeleteHabitButton_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <viewModels:HabitTemplateSelector x:Key="HabitTemplateSelector"
                                          BooleanHabitTemplate="{StaticResource BooleanHabitTemplate}"
                                          QuantitativeHabitTemplate="{StaticResource QuantitativeHabitTemplate}"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
                Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Dashboard"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="Twoje postępy na dziś"
                        FontSize="14"
                        Foreground="{StaticResource TextGray}"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="20"
                    Padding="10,5"
                    Margin="0,5,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                            Opacity="0.05"
                            BlurRadius="5"
                            ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30"
                            Height="30"
                            CornerRadius="15"
                            Background="{StaticResource PrimaryGreen}"
                            Margin="0,0,10,0">
                        <TextBlock Text="👤"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                FontSize="14"/>
                    </Border>

                    <TextBlock x:Name="CurrentUserTextBlock"
                            Text="Użytkownik"
                               VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextDark}"
                            Margin="0,0,15,0"/>

                    <Button x:Name="LogoutButton"
                            Content="Wyloguj"
                            Click="LogoutButton_Click"
                            Style="{StaticResource LogoutButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1"
                Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="5"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <DatePicker x:Name="DatePicker"
                        SelectedDateChanged="DatePicker_SelectedDateChanged"
                            Width="140"
                        BorderThickness="0"
                            VerticalContentAlignment="Center"
                            DisplayDateEnd="{x:Static System:DateTime.Today}"/>
            </Border>

            <StackPanel Grid.Column="2"
                    Orientation="Horizontal">
                <Button Content="📊 Statystyki"
                        Width="130"
                        Height="40"
                        Click="StatsButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"/>

                <Button Content="+ Nowy nawyk"
                        Width="140"
                        Height="40"
                        Click="AddHabitButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="2"
                x:Name="HabitsListView"
                  ItemsSource="{Binding DailyHabits}"
                  ItemTemplateSelector="{StaticResource HabitTemplateSelector}"
                  BorderThickness="0"
                Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,0,20">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>
                    <Setter Property="Margin"
                            Value="0,2"/>
                    <Setter Property="Cursor"
                            Value="Hand"/>
                    <Setter Property="FocusVisualStyle"
                            Value="{x:Null}"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="SelectionBorder"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="2"
                                        CornerRadius="12"
                                        Padding="3">

                                    <ContentPresenter/>

                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected"
                                            Value="True">
                                        <Setter TargetName="SelectionBorder"
                                                Property="BorderBrush"
                                                Value="#2ECC71"/>
                                        <Setter TargetName="SelectionBorder"
                                                Property="Background"
                                                Value="#F0FDF4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <Border Grid.Row="3"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Margin="0,15,0,0"
                Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock"
                        Text="Gotowe"
                        Foreground="{StaticResource TextGray}"
                        FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>